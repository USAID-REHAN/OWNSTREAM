PORT=3000
NODE_ENV=development
PUBLIC_WEB_URL=http://localhost:5173

# Neon (use the pooled connection string for the app)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# true for Neon, false for the local Docker database
DB_SSL=true

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Outside APIs
RAWG_API_KEY=your_rawg_key
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_WEBHOOK_SECRET=a_long_random_string

# Security
DEVICE_TOKEN_PEPPER=another_long_random_string

# WebRTC help servers (bonus streaming only)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
