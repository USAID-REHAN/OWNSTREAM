{
  "name": "ownstream",
  "private": true,
  "version": "0.1.0",
  "description": "Ownstream: private local AI and game streaming from your own home PC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "build:shared": "npm run build -w packages/shared",
    "build:server": "npm run build -w apps/server",
    "dev:server": "npm run start:dev -w apps/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  }
}
